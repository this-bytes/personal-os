# Normalise line endings on check-in, check out with LF everywhere.
#
# The repository is developed on Windows and built on Linux. Without this,
# the same file gets a different byte sequence depending on who touches it,
# which makes diffs unreadable and lets a whitespace-only change slip into a
# review. The formatter is configured for LF too, so the two agree.

* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# The lockfile is generated; keep it out of diff-based language statistics
# and out of any diff driver that would reorder it.
package-lock.json linguist-generated=true -diff

# The migration snapshots are generated by drizzle-kit.
apps/server/drizzle/meta/* linguist-generated=true -diff

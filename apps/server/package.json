{
  "name": "@personal-os/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal OS API server: conversations, agent connections, resources, factory, automations, MCP.",
  "main": "./dist/app.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/static": "10.1.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@personal-os/agent-adapters": "0.1.0",
    "@personal-os/contracts": "0.1.0",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}

# Shell assignments loaded by deploy/source-stack.sh. Keep this file private.

# --- required ---------------------------------------------------------------

# 32 bytes, base64 or hex. Both the server and the worker need the same key
# to read encrypted agent configuration.
#   openssl rand -base64 32
# Leave empty to persist a generated key alongside the database.
PERSONAL_OS_SECRET_KEY=

# --- optional ---------------------------------------------------------------

# API port; the panel and API proxy listen on PERSONAL_OS_WEB_PORT (5173).
PERSONAL_OS_PORT=4317

# A static token for headless access to the MCP endpoint and the API.
# Leave empty to disable it.
PERSONAL_OS_OWNER_TOKEN=

# Set to true when the deployment is served over HTTPS.
PERSONAL_OS_COOKIE_SECURE=false

# Where the database, generated files and secret key live.
# PERSONAL_OS_DATA_DIR=/absolute/path/to/personal-os/data

# Extra origins allowed to call the API. Only needed for the Vite dev server.
# PERSONAL_OS_EXTRA_ORIGINS=http://localhost:5173

# --- logging ----------------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

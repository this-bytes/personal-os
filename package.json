{
  "name": "personal-os",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Personal OS — the environment one person's agents operate and extend.",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  },
  "scripts": {
    "build": "npm run build -w @personal-os/contracts && npm run build -w @personal-os/agent-adapters && npm run build -w @personal-os/server && npm run build -w @personal-os/worker && npm run build -w @personal-os/web",
    "build:contracts": "npm run build -w @personal-os/contracts",
    "build:adapters": "npm run build -w @personal-os/agent-adapters",
    "build:deps": "npm run build -w @personal-os/contracts && npm run build -w @personal-os/agent-adapters && npm run build -w @personal-os/server",
    "dev": "npm run dev -w @personal-os/server",
    "predev": "npm run verify:dependencies",
    "predev:web": "npm run verify:dependencies",
    "predev:worker": "npm run verify:dependencies",
    "predev:stack": "npm run verify:dependencies",
    "dev:web": "npm run dev -w @personal-os/web",
    "dev:worker": "npm run dev -w @personal-os/worker",
    "dev:stack": "tsx scripts/dev.ts",
    "typecheck": "npm run build:deps && npm run typecheck:scripts && npm run typecheck --workspaces --if-present",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "npm run build:deps && npm run test --workspaces --if-present",
    "test:e2e": "npm run build && npm run test:e2e -w @personal-os/web",
    "smoke": "tsx scripts/smoke.ts",
    "verify:build": "tsx scripts/verify-build.ts",
    "verify:dependencies": "tsx scripts/verify-dependencies.ts",
    "reset:owner-password": "tsx scripts/reset-owner-password.ts",
    "verify:bundle": "tsx scripts/verify-bundle-size.ts",
    "verify:contracts": "tsx scripts/verify-contract-status.ts",
    "verify:mcp-parity": "tsx scripts/verify-mcp-parity.ts",
    "gates": "tsx scripts/verify-gates.ts",
    "verify:stack": "tsx scripts/verify-stack.ts",
    "work:item": "tsx scripts/work-item.ts",
    "db:migrate": "npm run db:migrate -w @personal-os/server",
    "db:generate": "npm run db:generate -w @personal-os/server",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "@personal-os/agent-adapters": "0.1.0",
    "@personal-os/contracts": "0.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "better-sqlite3": "13.0.3",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}

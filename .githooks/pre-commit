#!/bin/sh
#
# Warn when a commit is about to carry somebody else's work.
#
# Concurrent editors coordinate overlapping files. Staged and unstaged
# changes to the same file can indicate mixed ownership, so report them
# at commit time while the author can still inspect the staged hunks.
#
# This is that check. A file that is staged and also changed since it was
# staged is a file two hands are on. The commit takes the staged version and
# leaves the other edit behind, so the edit is not lost — but it is now in
# somebody else's commit, and the commit message will not mention it.
#
# It is a warning rather than a block, because the same shape appears in a
# single agent's own work: stage a file, keep editing it, and commit it
# later. That is legitimate. A warning that fires on it teaches the agent to
# ignore it, so the warning names the files and lets the agent decide.
#
# Set `core.hooksPath` to make this run:
#
#   git config core.hooksPath .githooks
#
set -f

staged=$(git diff --cached --name-only)
unstaged=$(git diff --name-only)

if [ -z "$staged" ] || [ -z "$unstaged" ]; then
  exit 0
fi

both=""

for file in $staged; do
  for other in $unstaged; do
    if [ "$file" = "$other" ]; then
      both="$both $file"
    fi
  done
done

if [ -n "$both" ]; then
  printf 'WARNING: these files are staged and have changed again since they were staged:\n'
  for file in $both; do
    printf '  %s\n' "$file"
  done
  printf 'The commit takes the staged version and leaves the other edit uncommitted.\n'
  printf 'If the other edit is not yours, stage only your own hunks and leave the rest alone.\n'
  printf 'See FACTORY.md, "Working in parallel".\n'
fi

exit 0
